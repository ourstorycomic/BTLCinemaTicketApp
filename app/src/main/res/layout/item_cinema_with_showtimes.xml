<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Cinema Header Row 1: Brand Logo + Cinema Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:adjustViewBounds="true"
                android:contentDescription="Logo rạp"
                android:scaleType="fitCenter"
                android:src="@drawable/cgv" />

            <TextView
                android:id="@+id/tvCinemaName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="CGV Aeon Bình Tân"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cinema Header Row 2: Address & Location -->
        <TextView
            android:id="@+id/tvCinemaAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Tầng 3, TTTM Aeon Mall Bình Tân, 1 Đường số 17A, P. Bình Trị Đông B"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <!-- Cinema Header Row 3: Facilities -->
        <TextView
            android:id="@+id/tvCinemaFacilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tiện ích: 4DX, IMAX, Dolby Atmos, Sweetbox, Parking"
            android:textColor="@color/cinema_red"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#EEEEEE" />

        <!-- Showtimes Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCinemaShowtimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
