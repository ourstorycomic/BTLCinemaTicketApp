<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên rạp chiếu phim *"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCinemaName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_border"
            android:hint="VD: CineCinema 8 - Landmark"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tỉnh / Thành Phố *"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCity"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_border"
            android:paddingHorizontal="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Địa chỉ chi tiết *"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_border"
            android:hint="VD: Tầng B1, Tòa nhà Landmark 81, 720A Điện Biên Phủ"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hotline *"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_border"
            android:hint="VD: 1900 2026"
            android:text="1900 2026"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tiện ích &amp; Công nghệ"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFacilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_border"
            android:hint="VD: IMAX Laser, Dolby Atmos, VIP Lounge, Parking"
            android:text="IMAX, Dolby Atmos, Sweetbox, Parking"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Giờ hoạt động"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOperatingHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_border"
            android:hint="VD: 08:00 - 23:30"
            android:text="08:00 - 23:30"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
